---
// Proof-first surface grid for case studies.
// Shows each shippable product with a live link + lightweight demo video,
// before the long-form prose. Videos use preload="none" + poster so nothing
// downloads until the visitor opts in.
import { isPendingUrl } from "@/data/lab-precision";

interface Surface {
  name: string;
  nameFr?: string;
  blurb: string;
  blurbFr?: string;
  status: string;
  statusFr?: string;
  url?: string;
  urlLabel?: string;
  urlLabelFr?: string;
  video?: string;
  poster?: string;
  stack?: string[];
}

interface Props {
  surfaces: Surface[];
  lang?: "en" | "fr";
  heading?: string;
}

const { surfaces, lang = "en", heading } = Astro.props;
const isFr = lang === "fr";
const title = heading ?? (isFr ? "Surfaces livrées" : "Shipped surfaces");
const demoLabel = isFr ? "Démo" : "Demo";
const pendingTitle = isFr ? "Lien public à venir" : "Public URL coming soon";

const pick = (en: string | undefined, fr: string | undefined) =>
  (isFr ? fr : en) ?? en ?? fr ?? "";
---

{
  surfaces.length > 0 && (
    <section class="surfaces" id="proof" aria-label={title}>
      <h2 class="surfaces__title">{title}</h2>
      <ul class="surfaces__list">
        {surfaces.map((s) => {
          const name = pick(s.name, s.nameFr);
          const blurb = pick(s.blurb, s.blurbFr);
          const status = pick(s.status, s.statusFr);
          const urlLabel = pick(s.urlLabel, s.urlLabelFr) || s.url?.replace(/^https?:\/\//, "");
          return (
            <li class="surface">
              <div class="surface__head">
                <div class="surface__id">
                  <span class="surface__name">{name}</span>
                  <span class="surface__status">{status}</span>
                </div>
                {s.url && !isPendingUrl(s.url) ? (
                  <a class="surface__link" href={s.url} target="_blank" rel="noopener noreferrer">
                    {urlLabel}
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" width="12" height="12">
                      <path d="M5 11L11 5M11 5H6M11 5V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                ) : s.url && isPendingUrl(s.url) ? (
                  <span class="surface__link surface__link--pending" title={pendingTitle}>{urlLabel}</span>
                ) : (
                  <span class="surface__link surface__link--none">{urlLabel || (isFr ? "Non déployé" : "Not deployed")}</span>
                )}
              </div>

              {s.video && (
                <figure class="surface__media">
                  <video
                    class="surface__video"
                    controls
                    preload="none"
                    muted
                    playsinline
                    poster={s.poster}
                  >
                    <source src={s.video} type="video/mp4" />
                  </video>
                  <figcaption class="surface__caption">{demoLabel}</figcaption>
                </figure>
              )}

              <p class="surface__blurb">{blurb}</p>

              {s.stack && s.stack.length > 0 && (
                <ul class="surface__stack">
                  {s.stack.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )
}
