---
interface Props {
  locale?: "en" | "fr";
}

const { locale = "en" } = Astro.props;

const t =
  locale === "fr"
    ? {
        skip: "Aller au tableau",
        themeToggle: "Basculer le thème",
        themeTitle: "Thème",
        bootKicker: "Tableau de bord",
        bootName: "Aliou Wade",
        bootRole: "Ingénieur systèmes produit · Dakar",
        proofStage: "Scène de preuve",
        domains: "Domaines",
        problemDomains: "Domaines problème",
        projectsProving: "Projets prouvant ce domaine",
        collapseComms: "Réduire le panneau contact",
        contact: "Contact",
        workRecord: "Registre de travail",
        fullRecord: "Registre complet",
        employers: "Employeurs",
        clientBuilds: "Projets clients",
        expandRecord: "Ouvrir le registre complet",
        closeRecord: "Fermer le registre",
        fieldNotes: "Notes de terrain",
        toolkit: "Boîte à outils",
        close: "Fermer",
      }
    : {
        skip: "Skip to board",
        themeToggle: "Toggle dark mode",
        themeTitle: "Toggle theme",
        bootKicker: "Operator board",
        bootName: "Aliou Wade",
        bootRole: "Product Systems Engineer · Dakar",
        proofStage: "Proof stage",
        domains: "Domains",
        problemDomains: "Problem domains",
        projectsProving: "Projects proving this domain",
        collapseComms: "Collapse contact panel",
        contact: "Contact",
        workRecord: "Work record",
        fullRecord: "Full record",
        employers: "Employers",
        clientBuilds: "Client builds",
        expandRecord: "Expand full work record",
        closeRecord: "Close full record",
        fieldNotes: "Field notes",
        toolkit: "Toolkit",
        close: "Close",
      };
---

<a href="#board" class="skip-link">{t.skip}</a>
<div class="ambient-grain" aria-hidden="true"></div>

<main class="board" id="board">
  <div class="boot-overlay" id="bootOverlay" aria-hidden="true">
    <div class="boot-stack">
      <div class="boot-head">
        <span class="boot-kicker mono">{t.bootKicker}</span>
        <h2 class="boot-name">{t.bootName}</h2>
        <p class="boot-role mono">{t.bootRole}</p>
      </div>
      <div class="boot-lines mono" id="bootLines"></div>
    </div>
  </div>

  <header class="board-rail" id="statusRail">
    <div class="rail-brand">
      <div class="rail-identity">
        <div class="rail-title-row">
          <h1 class="rail-name">Aliou Wade</h1>
          <span class="rail-sep mono" aria-hidden="true">/</span>
          <span class="rail-role" id="railRole">Product Systems Engineer</span>
        </div>
      </div>
    </div>
    <p class="rail-status mono ui-pill ui-pill--dot" id="statusGreeting" aria-live="polite"></p>
    <div class="rail-context">
      <button type="button" class="theme-toggle" id="themeToggle" aria-label={t.themeToggle} aria-pressed="false" title={t.themeTitle}>
        <span class="theme-toggle__icon" aria-hidden="true">
          <svg class="theme-toggle__sun" width="15" height="15" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="3.25" stroke="currentColor" stroke-width="1.5"></circle><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
          <svg class="theme-toggle__moon" width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M7.2 2.2a5.8 5.8 0 1 0 6.6 9.4A6.2 6.2 0 0 1 7.2 2.2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
        </span>
      </button>
      <span id="localeSwitch"></span>
    </div>
  </header>

  <div class="board-body" id="boardBody">
    <section class="proof-zone" aria-label={t.proofStage}>
      <div class="zone-label" aria-hidden="true">
        <span class="zone-label__tick"></span>
        <span class="zone-label__text mono">{t.domains}</span>
      </div>
      <div class="domain-tabs" id="domainTabs" role="tablist" aria-label={t.problemDomains}></div>

      <div
        class="proof-stage"
        id="proofStage"
        role="tabpanel"
        aria-live="polite"
        aria-labelledby="domainTabs"
      >
        <div class="case-row" id="caseRow">
          <div class="case-tabs" id="proofPeeks" role="tablist" aria-label={t.projectsProving}></div>
        </div>
        <div class="proof-anchor-tray">
          <article class="proof-anchor" id="proofAnchor"></article>
        </div>
      </div>
    </section>

    <button
      type="button"
      class="signal-rail"
      id="sidebarHandle"
      aria-expanded="true"
      aria-controls="commsZone"
      aria-label={t.collapseComms}
    >
      <span class="signal-rail__bracket" aria-hidden="true"></span>
      <span class="signal-rail__frame" aria-hidden="true">
        <span class="signal-rail__trace"></span>
      </span>
    </button>

    <aside class="comms-zone" id="commsZone" aria-label={t.contact}>
      <div class="zone-label" aria-hidden="true">
        <span class="zone-label__tick"></span>
        <span class="zone-label__text mono">{t.contact}</span>
      </div>
      <div class="comms-tray">
        <div class="comms-core" id="commsCore"></div>
      </div>
    </aside>
  </div>

  <footer class="ledger-bar" id="ledgerBar">
    <div class="ledger-collapsed" id="ledgerCollapsed">
      <span class="ledger-bar-kicker" aria-hidden="true">{t.workRecord}</span>
      <div class="ledger-group">
        <span class="ledger-group-label">{t.employers}</span>
        <div class="ledger-employers" id="ledgerEmployersPreview"></div>
      </div>
      <div class="ledger-group">
        <span class="ledger-group-label">{t.clientBuilds}</span>
        <div class="ledger-clients" id="ledgerClientsPreview"></div>
      </div>
      <button type="button" class="ledger-expand-btn hw-btn" id="ledgerExpandBtn" aria-expanded="false" aria-controls="ledgerExpanded" aria-label={t.expandRecord}>
        {t.fullRecord}
      </button>
    </div>

    <div class="ledger-expanded" id="ledgerExpanded" hidden>
      <div class="ledger-expanded-head">
        <div class="ledger-expanded-intro">
          <h2 class="ledger-title" id="ledgerTitle">{t.workRecord}</h2>
          <p class="ledger-subtitle" id="ledgerSubtitle"></p>
        </div>
        <button type="button" class="ledger-close hw-btn" id="ledgerCloseBtn" aria-label={t.closeRecord}>{t.close}</button>
      </div>
      <div class="ledger-expanded-grid">
        <section class="ledger-panel" aria-labelledby="employersHeading">
          <h3 class="panel-label" id="employersHeading">{t.employers}</h3>
          <div class="ledger-panel-surface">
            <ul class="employer-list" id="employerList"></ul>
          </div>
        </section>
        <section class="ledger-panel" aria-labelledby="clientsHeading">
          <h3 class="panel-label" id="clientsHeading">{t.clientBuilds}</h3>
          <div class="ledger-panel-surface ledger-panel-surface--scroll">
            <ul class="client-list" id="clientList"></ul>
          </div>
        </section>
        <section class="ledger-panel ledger-panel--writing" aria-labelledby="notesHeading">
          <h3 class="panel-label" id="notesHeading">{t.fieldNotes}</h3>
          <div class="field-notes-card essay-teaser" id="essayTeaser"></div>
        </section>
      </div>
      <div class="ledger-toolkit" aria-labelledby="toolkitHeading">
        <span class="toolkit-label" id="toolkitHeading">{t.toolkit}</span>
        <div class="stack-list" id="stackList"></div>
      </div>
    </div>
  </footer>
</main>

<div class="copy-toast mono" id="copyToast" role="status" aria-live="polite"></div>

<script>
  import "@/scripts/board-boot.ts";
</script>
