---
import { Moon02Icon, Sun01Icon } from "@hugeicons/core-free-icons";
import HugeIcon from "./HugeIcon.astro";

interface Props {
  locale?: "en" | "fr";
}

const locale = Astro.props.locale ?? "en";
const isFr = locale === "fr";

const ui = isFr
  ? {
      backToWork: "Retour aux mandats",
      switchHref: "/",
      switchBase: "/",
      switchLabel: "EN",
      switchAria: "Passer en anglais",
      themeAria: "Passer en mode sombre",
    }
  : {
      backToWork: "Back to engagements",
      switchHref: "/fr/",
      switchBase: "/fr/",
      switchLabel: "FR",
      switchAria: "Switch to French",
      themeAria: "Switch to dark mode",
    };
---

<div class="lp-nav-shell">
  <header class="lp-header">
    <button class="lp-back-to-work" type="button" data-view-trigger="work" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path
          d="M10.5 3.5L3.5 10.5M3.5 10.5V4.75M3.5 10.5H9.25"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span>{ui.backToWork}</span>
    </button>

    <div class="lp-header-tools">
      <a
        class="lp-locale"
        href={ui.switchHref}
        data-locale-link={ui.switchBase}
        hreflang={isFr ? "en" : "fr"}
        lang={isFr ? "en" : "fr"}
        aria-label={ui.switchAria}>{ui.switchLabel}</a>

      <button
        id="theme-toggle"
        class="lp-theme"
        type="button"
        aria-label={ui.themeAria}
        aria-pressed="false"
      >
        <span class="lp-theme-icon">
          <HugeIcon icon={Sun01Icon} class="lp-theme-sun" size={15} />
          <HugeIcon icon={Moon02Icon} class="lp-theme-moon" size={15} />
        </span>
      </button>
    </div>
  </header>
</div>
