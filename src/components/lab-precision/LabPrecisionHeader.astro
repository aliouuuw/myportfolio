---
import { Moon02Icon, Sun01Icon } from "@hugeicons/core-free-icons";
import HugeIcon from "./HugeIcon.astro";

interface Props {
  locale?: "en" | "fr";
}

const locale = Astro.props.locale ?? "en";
const isFr = locale === "fr";

const ui = isFr
  ? {
      backToWork: "Retour aux mandats",
      lang: "Langue",
      langEn: "Anglais",
      langFr: "Français",
    }
  : {
      backToWork: "Back to engagements",
      lang: "Language",
      langEn: "English",
      langFr: "French",
    };
---

<div class="lp-nav-shell">
  <header class="lp-header">
    <button class="lp-back-to-work" type="button" data-view-trigger="work" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path
          d="M10.5 3.5L3.5 10.5M3.5 10.5V4.75M3.5 10.5H9.25"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span>{ui.backToWork}</span>
    </button>

    <div class="lp-header-tools">
      <div class="lp-locales" role="group" aria-label={ui.lang}>
        <a
          class:list={["lp-locale", { "is-active": !isFr }]}
          href="/"
          data-locale-link="/"
          hreflang="en"
          lang="en"
          aria-label={ui.langEn}
          aria-current={!isFr ? "true" : undefined}>EN</a>
        <a
          class:list={["lp-locale", { "is-active": isFr }]}
          href="/fr/"
          data-locale-link="/fr/"
          hreflang="fr"
          lang="fr"
          aria-label={ui.langFr}
          aria-current={isFr ? "true" : undefined}>FR</a>
      </div>

      <button
        id="theme-toggle"
        class="lp-theme"
        type="button"
        aria-label={isFr ? "Passer en mode sombre" : "Switch to dark mode"}
        aria-pressed="false"
      >
        <span class="lp-theme-icon">
          <HugeIcon icon={Sun01Icon} class="lp-theme-sun" size={15} />
          <HugeIcon icon={Moon02Icon} class="lp-theme-moon" size={15} />
        </span>
      </button>
    </div>
  </header>
</div>
