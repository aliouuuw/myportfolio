---
import CareerGraph from "@/components/lab-precision/CareerGraph.astro";
import BioContactLinks from "@/components/lab-precision/BioContactLinks.astro";
import { credentials } from "@/data/lab-precision";

interface Props {
  locale?: "en" | "fr";
}

const locale = Astro.props.locale ?? "en";
const isFr = locale === "fr";

const primaryCreds = credentials.filter((c) => c.featured === true);
const secondaryCreds = credentials.filter((c) => c.featured !== true);

const ui = isFr
  ? {
      portraitAlt: "Portrait d'Aliou Wade",
      portraitCaption: "Aliou Wade, Dakar",
      role: "Bio",
      headline: "Principalement des systèmes.",
      bioParagraphs: [
        "Chez Everest Finance, je gère trois produits fintech, principalement en solo. Je m'occupe aussi bien des applications et des données que des intégrations, du déploiement et de la production.",
        "Avant ça, j'ai travaillé sur des ERP et des migrations chez ERGOBIT, avec des modules sur mesure en RH, paie et compta, et le kit de tests d'acceptation Odoo 18.",
        "Au fil des années, j'ai travaillé dans la fintech, la logistique, le mobile, l'IoT et l'éducation. Je transforme souvent du travail manuel compliqué en logiciel sur lequel les équipes comptent.",
        "Basé à Dakar. Français et anglais. Je réponds sous 48 h, du lundi au vendredi.",
      ],
      offClockTitle: "Hors du bureau",
      offClock: "Échecs compétitifs. Je tourne autour de 2043 en bullet en ligne.",
      journeyTitle: "Parcours",
      journeyLead: "Où j'ai bossé depuis 2018.",
      journeyRef: "career/main",
      credsTitle: "Formation & certifications",
      credsRef: (n: number) => `${n} entrées`,
      moreCreds: "Autres certifications",
    }
  : {
      portraitAlt: "Portrait of Aliou Wade",
      portraitCaption: "Aliou Wade, Dakar",
      role: "Bio",
      headline: "Mostly systems work.",
      bioParagraphs: [
        "At Everest Finance, I run three fintech products, mostly on my own. I handle everything from the applications and data to integrations, deployment, and production.",
        "Before that, I worked on ERP and migrations at ERGOBIT, with custom HR, payroll, and accounting modules, and the Odoo 18 acceptance testing kit.",
        "Over the years, I've worked across fintech, logistics, mobile, IoT, and education. I usually turn messy manual work into software people can rely on.",
        "Based in Dakar. French and English. I reply within 48h, Monday to Friday.",
      ],
      offClockTitle: "Off the clock",
      offClock: "Competitive chess. I hover around 2043 bullet online.",
      journeyTitle: "Journey",
      journeyLead: "Where I've worked since 2018.",
      journeyRef: "career/main",
      credsTitle: "Credentials",
      credsRef: (n: number) => `${n} entries`,
      moreCreds: "Other certifications",
    };
---

<div class="lp-about">
  <section class="lp-about-hero">
    <figure class="lp-portrait">
      <div class="lp-bezel">
        <div class="lp-bezel-inner">
          <img src="/Aliou.png" alt={ui.portraitAlt} width="795" height="1024" />
        </div>
      </div>
      <figcaption>{ui.portraitCaption}</figcaption>
    </figure>
    <div class="lp-about-intro">
      <p class="lp-bio-role">{ui.role}</p>
      <h1 class="lp-bio-name">{ui.headline}</h1>
      {ui.bioParagraphs.map((paragraph) => (
        <p class="lp-bio-line">{paragraph}</p>
      ))}
      <div class="lp-about-cta">
        <a class="lp-about-cta-primary" href="mailto:wadealiou00@gmail.com">
          {isFr ? "M'écrire" : "Email me"}
        </a>
      </div>
      <div class="lp-off-clock">
        <h2>{ui.offClockTitle}</h2>
        <p>{ui.offClock}</p>
      </div>
    </div>
  </section>

  <section class="lp-journey" aria-labelledby="journey-title">
    <div class="lp-section-head">
      <div class="lp-section-head-copy">
        <h2 id="journey-title">{ui.journeyTitle}</h2>
        <p class="lp-section-lead">{ui.journeyLead}</p>
      </div>
      <span class="lp-git-ref">{ui.journeyRef}</span>
    </div>
    <CareerGraph locale={locale} />
  </section>

  <section class="lp-creds" aria-labelledby="credentials-title">
    <div class="lp-section-head">
      <h2 id="credentials-title">{ui.credsTitle}</h2>
      <span>{ui.credsRef(primaryCreds.length)}</span>
    </div>
    <ul class="lp-cred-list">
      {
        primaryCreds.map((entry) => (
          <li>
            <strong>{isFr ? (entry.itemFr ?? entry.item) : entry.item}</strong>
            <span>{isFr ? (entry.detailFr ?? entry.detail) : entry.detail}</span>
          </li>
        ))
      }
    </ul>
    {
      secondaryCreds.length > 0 && (
        <details class="lp-creds-more">
          <summary>{ui.moreCreds}</summary>
          <ul class="lp-cred-list lp-cred-list--quiet">
            {secondaryCreds.map((entry) => (
              <li>
                <strong>{isFr ? (entry.itemFr ?? entry.item) : entry.item}</strong>
                <span>{isFr ? (entry.detailFr ?? entry.detail) : entry.detail}</span>
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </section>

  <footer class="lp-work-footer lp-about-footer">
    <BioContactLinks locale={locale} />
  </footer>
</div>
