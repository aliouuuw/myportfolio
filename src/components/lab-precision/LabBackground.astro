---
import { credentials, journey } from "@/data/lab-precision";

interface Props {
  locale?: "en" | "fr";
}

const locale = Astro.props.locale ?? "en";
const isFr = locale === "fr";

const ui = isFr
  ? {
      portraitAlt: "Portrait d'Aliou Wade",
      portraitCaption: "Aliou Wade, Dakar",
      role: "Parcours",
      headline: "De l'ingénierie avec du contexte opérationnel.",
      bio: "Six ans à construire des logiciels opérationnels en fintech, ERP, logistique et éducation. Ottawa à Dakar, bilingue français et anglais. Je travaille sur les systèmes que les entreprises font réellement tourner, pas ceux qui font joli en démo.",
      offClockTitle: "Hors du bureau",
      offClock:
        "Échecs compétitifs, environ 2043 en bullet en ligne. La même discipline que livrer sous deadline.",
      journeyTitle: "Parcours",
      journeyRef: (n: number) => `main · ${n} commits`,
      credsTitle: "Formation et certifications",
      credsRef: (n: number) => `${n} enregistrements`,
    }
  : {
      portraitAlt: "Portrait of Aliou Wade",
      portraitCaption: "Aliou Wade, Dakar",
      role: "Background",
      headline: "Engineering with operational context.",
      bio: "Six years building operational software across fintech, ERP, logistics, and education. Ottawa to Dakar, bilingual French and English. I work on the systems businesses actually run on, not the ones that demo well.",
      offClockTitle: "Off the clock",
      offClock:
        "Competitive chess, around 2043 bullet online. Same discipline as shipping under deadline.",
      journeyTitle: "Journey",
      journeyRef: (n: number) => `main · ${n} commits`,
      credsTitle: "Education and certifications",
      credsRef: (n: number) => `${n} records`,
    };
---

<div class="lp-about">
  <section class="lp-about-hero">
    <figure class="lp-portrait">
      <div class="lp-bezel">
        <div class="lp-bezel-inner">
          <img src="/Aliou.png" alt={ui.portraitAlt} width="795" height="1024" />
        </div>
      </div>
      <figcaption>{ui.portraitCaption}</figcaption>
    </figure>
    <div class="lp-about-intro">
      <p class="lp-bio-role">{ui.role}</p>
      <h1 class="lp-bio-name">{ui.headline}</h1>
      <p class="lp-bio-line">{ui.bio}</p>
      <ul class="lp-bio-links">
        <li>
          <a href="mailto:wadealiou00@gmail.com">wadealiou00@gmail.com</a>
        </li>
        <li><a href="https://www.linkedin.com/in/aliouuuw">LinkedIn</a></li>
        <li><a href="https://github.com/aliouuuw">GitHub</a></li>
        <li><a href="https://wa.me/221777228845">WhatsApp</a></li>
      </ul>
      <div class="lp-off-clock">
        <h2>{ui.offClockTitle}</h2>
        <p>{ui.offClock}</p>
      </div>
    </div>
  </section>

  <section class="lp-journey lp-git-journey" aria-labelledby="journey-title">
    <div class="lp-section-head">
      <h2 id="journey-title">{ui.journeyTitle}</h2>
      <span class="lp-git-ref">{ui.journeyRef(journey.length)}</span>
    </div>
    <ol class="lp-git-log">
      {
        journey.map((entry, index) => (
          <li class="lp-git-commit" style={`--git-i: ${index}`}>
            <div class="lp-git-graph" aria-hidden="true">
              <span class="lp-git-track"></span>
              <span class="lp-git-node"></span>
            </div>
            <details class="lp-git-details">
              <summary class="lp-git-summary">
                <span class="lp-git-summary-caret" aria-hidden="true"></span>
                <span class="lp-git-summary-main">
                  <code class="lp-git-branch">{entry.branch}</code>
                  <span class="lp-git-title">{isFr ? (entry.roleFr ?? entry.role) : entry.role}</span>
                  <span class="lp-git-meta">
                    <span class="lp-git-org">{isFr ? (entry.orgFr ?? entry.org) : entry.org}</span>
                    <span class="lp-git-period">{isFr ? (entry.periodFr ?? entry.period) : entry.period}</span>
                  </span>
                </span>
              </summary>
              <p class="lp-git-note">{isFr ? (entry.noteFr ?? entry.note) : entry.note}</p>
            </details>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="lp-creds" aria-labelledby="credentials-title">
    <div class="lp-section-head">
      <h2 id="credentials-title">{ui.credsTitle}</h2>
      <span>{ui.credsRef(credentials.length)}</span>
    </div>
    <ul class="lp-cred-list">
      {
        credentials.map((entry) => (
          <li>
            <strong>{isFr ? (entry.itemFr ?? entry.item) : entry.item}</strong>
            <span>{isFr ? (entry.detailFr ?? entry.detail) : entry.detail}</span>
          </li>
        ))
      }
    </ul>
  </section>
</div>
