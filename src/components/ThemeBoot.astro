---
/** Blocking inline theme + first-visit locale boot. Must stay unbundled. */
---

<script is:inline>
  (function () {
    try {
      var theme =
        localStorage.getItem("portfolio-theme") ||
        localStorage.getItem("operator-board-theme");
      if (theme === "dark" || theme === "light") {
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("portfolio-theme", theme);
      }
    } catch (e) {
      /* ignore */
    }

    try {
      var cookie = document.cookie || "";
      if (cookie.indexOf("portfolio-locale-detected=1") !== -1) return;

      document.cookie =
        "portfolio-locale-detected=1; Path=/; Max-Age=31536000; SameSite=Lax";

      var path = location.pathname;
      if (path === "/fr" || path.indexOf("/fr/") === 0) return;

      var langs = navigator.languages && navigator.languages.length
        ? navigator.languages
        : [navigator.language];
      var preferFr = false;
      for (var i = 0; i < langs.length; i++) {
        var tag = String(langs[i] || "").toLowerCase();
        if (tag === "fr" || tag.indexOf("fr-") === 0) {
          preferFr = true;
          break;
        }
        if (tag === "en" || tag.indexOf("en-") === 0) {
          break;
        }
      }
      if (!preferFr) return;

      var dest = path === "/" ? "/fr/" : "/fr" + path;
      location.replace(dest + location.search + location.hash);
    } catch (e2) {
      /* ignore */
    }
  })();
</script>
