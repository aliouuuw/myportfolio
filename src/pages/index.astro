---
import "@/styles/lab-precision.css";
import LabBackground from "@/components/lab-precision/LabBackground.astro";
import LabPrecisionHeader from "@/components/lab-precision/LabPrecisionHeader.astro";
import { getEngagements, domainSlug } from "@/lib/work-registry";

/* Anchors first (Everest → Odoo toolkit → BocalBun), then supporting by period. */
const engagements = await getEngagements("en");
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aliou Wade · Software Engineer</title>
    <meta
      name="description"
      content="Software Engineer - operational systems for fintechs and ops-heavy businesses. Everest Finance, Odoo acceptance testing, systems judgment."
    />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=switzer@300,400,500,600,700&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      import { initTheme } from "@/scripts/theme";
      initTheme();
    </script>
  </head>
  <body class="lp" data-view="work">
    <a class="lp-skip" href="#lp-foreground">Skip to content</a>

    <LabPrecisionHeader locale="en" />

    <div class="lp-stage">
      <div class="lp-background" id="lp-background" aria-hidden="true" inert>
        <div class="lp-background-scroll">
          <div class="lp-main lp-background-main">
            <LabBackground locale="en" />
          </div>
        </div>
      </div>

      <main id="lp-foreground" class="lp-foreground">
        <div class="lp-main">
          <div class="lp-work">
            <section class="lp-work-hero lp-reveal" aria-labelledby="work-title">
              <div class="lp-work-intro">
                <p class="lp-bio-role">Software Engineer</p>
                <h1 id="work-title" class="lp-bio-name">Aliou Wade</h1>
                <p class="lp-bio-line">
                  Operational systems for fintechs and ops-heavy businesses.
                </p>
                <ul class="lp-bio-links">
                  <li>
                    <a href="mailto:wadealiou00@gmail.com">wadealiou00@gmail.com</a>
                  </li>
                  <li><a href="https://www.linkedin.com/in/aliouuuw">LinkedIn</a></li>
                  <li><a href="https://github.com/aliouuuw">GitHub</a></li>
                  <li><a href="https://wa.me/221777228845">WhatsApp</a></li>
                </ul>
                <div class="lp-bio-actions">
                  <button class="lp-bio-more" type="button" data-view-trigger="background">
                    <span>Check my background</span>
                    <span class="lp-btn-icon" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path
                          d="M3.5 10.5L10.5 3.5M10.5 3.5H4.75M10.5 3.5V9.25"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                      </svg>
                    </span>
                  </button>
                </div>
              </div>
            </section>

            <section class="lp-roster lp-reveal" aria-labelledby="engagements-title">
              <div class="lp-section-head lp-roster-head">
                <h2 id="engagements-title">Engagements</h2>
                <span class="lp-roster-ref">{engagements.length} clients</span>
              </div>

              <div class="lp-console" id="engagement-console">
                <nav class="lp-console-rail" aria-label="Engagements">
                  <ul class="lp-console-cap-list" role="list">
                    {engagements.map((eng) => (
                      <li>
                        <button
                          class="lp-console-cap"
                          type="button"
                          id={`engagement-${eng.slug}`}
                          data-eng={eng.slug}
                          aria-controls={`dossier-${eng.slug}`}
                          aria-expanded="false"
                        >
                          <span class="lp-console-cap-name">{eng.name}</span>
                          <span class="lp-console-cap-period">{eng.period}</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </nav>

                <div class="lp-console-dossier">
                  {engagements.map((eng) => (
                    <div
                      class:list={["lp-dossier", eng.surfaces.length === 1 && "lp-dossier--solo"]}
                      id={`dossier-${eng.slug}`}
                      role="region"
                      aria-labelledby={`engagement-${eng.slug}`}
                    >
                      <h3 class="lp-dossier-title">{eng.name}</h3>
                      <p class="lp-dossier-sub">{eng.detail}</p>
                      <div class="lp-dossier-meta-row">
                        <span class="lp-dossier-period">{eng.period}</span>
                        <span class={`lp-dossier-domain lp-dossier-domain--${domainSlug(eng.domain)}`}>{eng.domain}</span>
                      </div>
                      {eng.surfaces.length > 0 && (
                        <div class="lp-dossier-surfaces">
                          {eng.surfaces.map((surface) => (
                            <div class="lp-dossier-surface">
                              <h5 class="lp-dossier-surface-name">{surface.name}</h5>
                              <p class="lp-dossier-surface-blurb">{surface.blurb}</p>
                              {surface.stack.length > 0 && (
                                <p class="lp-dossier-surface-stack">{surface.stack.join(" · ")}</p>
                              )}
                              {surface.url && (
                                <a class="lp-dossier-surface-link" href={surface.url} target="_blank" rel="noopener">
                                  {surface.urlLabel ?? "View project"}
                                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                    <path d="M3 9L9 3M9 3H4.5M9 3V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                </a>
                              )}
                            </div>
                          ))}
                        </div>
                      )}
                      {eng.href && (
                        <a class="lp-dossier-link" href={eng.href}>
                          <span>View case study</span>
                          <span class="lp-dossier-link-icon" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                              <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.75M10.5 3.5V9.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                        </a>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </section>
          </div>
        </div>
      </main>
    </div>

    <div
      class="lp-preview"
      id="lp-preview"
      hidden
      role="dialog"
      aria-label="Project preview"
    >
      <div class="lp-bezel lp-preview-bezel">
        <div class="lp-bezel-inner lp-preview-frame">
          <video id="lp-preview-video" muted playsinline loop preload="none"></video>
          <div class="lp-preview-empty" id="lp-preview-empty" hidden>
            <span class="lp-preview-empty-kicker">Spec</span>
            <span id="lp-preview-empty-name">No preview</span>
          </div>
        </div>
      </div>
      <p class="lp-preview-cap" id="lp-preview-cap"></p>
    </div>

    <script>
      import { initLabPrecisionChrome } from "@/scripts/lab-precision-chrome";
      import { createLabPrecisionController } from "@/scripts/lab-precision-controller";
      import { initEngagementConsole } from "@/scripts/capability-console";

      initLabPrecisionChrome();
      initEngagementConsole();

      createLabPrecisionController({
        mediaRoot: "/media/case-studies/everest-finance",
        onBackground: () => {
          // Preview auto-hidden by controller when view switches to background
        },
      });
    </script>
  </body>
</html>
