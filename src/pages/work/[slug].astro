---
/**
 * Soft-deprecated: long-form /work/[slug] pages redirect to the home
 * Engagement Console dossier (`/#engagement-<slug>`).
 */
import { getCollection } from "astro:content";
import { workSlug } from "@/lib/work-nav";

export async function getStaticPaths() {
  const entries = await getCollection("work", (e) => e.id.endsWith("/en"));
  return entries.map((entry) => ({
    params: { slug: workSlug(entry) },
  }));
}

const slug = Astro.params.slug!;
const target = `/#engagement-${slug}`;
const title = "Aliou Wade";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href="/" />
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <p>
      <a href={target}>Open work dossier</a>
    </p>
  </body>
</html>
