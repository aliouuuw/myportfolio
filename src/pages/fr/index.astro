---
import "@/styles/lab-precision.css";
import LabBackground from "@/components/lab-precision/LabBackground.astro";
import LabPrecisionHeader from "@/components/lab-precision/LabPrecisionHeader.astro";
import { engagements, engagementsByDomain, directoryColumns, domainSlug } from "@/data/lab-precision";
---

<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aliou Wade · Ingénieur produit systèmes</title>
    <meta
      name="description"
      content="Logiciels opérationnels pour fintechs et entreprises à forte charge opérationnelle."
    />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=switzer@300,400,500,600,700&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("lab-precision-theme") === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch (e) {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body class="lp" data-view="work">
    <a class="lp-skip" href="#lp-foreground">Aller au contenu</a>

    <LabPrecisionHeader locale="fr" />

    <div class="lp-stage">
      <div class="lp-background" id="lp-background" aria-hidden="true" inert>
        <div class="lp-background-scroll">
          <div class="lp-main lp-background-main">
            <LabBackground />
          </div>
        </div>
      </div>

      <main id="lp-foreground" class="lp-foreground">
        <div class="lp-main">
          <div class="lp-work">
            <section class="lp-work-hero lp-reveal" aria-labelledby="work-title">
              <div class="lp-work-intro">
                <p class="lp-bio-role">Product Systems Engineer</p>
                <h1 id="work-title" class="lp-bio-name">Aliou Wade</h1>
                <p class="lp-bio-line">
                  I build operational software for fintechs and operations-heavy businesses.
                </p>
                <ul class="lp-bio-links">
                  <li>
                    <a href="mailto:wadealiou00@gmail.com">wadealiou00@gmail.com</a>
                  </li>
                  <li><a href="https://www.linkedin.com/in/aliouuuw">LinkedIn</a></li>
                  <li><a href="https://github.com/aliouuuw">GitHub</a></li>
                  <li><a href="https://wa.me/221777228845">WhatsApp</a></li>
                </ul>
                <div class="lp-bio-actions">
                  <button class="lp-bio-more" type="button" data-view-trigger="background">
                    <span>Check my background</span>
                    <span class="lp-btn-icon" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path
                          d="M3.5 10.5L10.5 3.5M10.5 3.5H4.75M10.5 3.5V9.25"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                      </svg>
                    </span>
                  </button>
                </div>
              </div>
            </section>

            <section class="lp-roster lp-reveal" aria-labelledby="engagements-title">
              <div class="lp-section-head lp-roster-head">
                <h2 id="engagements-title">Engagements</h2>
                <span class="lp-roster-ref">{engagements.length} clients · par domaine</span>
              </div>

              <div class="lp-directory" id="rows">
                {
                  engagementsByDomain.map((group) => {
                    const columns = directoryColumns(group.entries, 2);
                    return (
                      <div class={`lp-dir-group lp-dir-group--${domainSlug(group.domain)}`}>
                        <header class="lp-dir-heading">
                          <h3 class="lp-dir-title">{group.domain}</h3>
                        </header>
                        <div class="lp-dir-list">
                          {columns.map((column) => (
                            <ul class="lp-dir-col">
                              {column.map((entry) => (
                                <li
                                  class:list={[
                                    "lp-roster-item",
                                    "lp-row",
                                    { "lp-row--peekable": entry.media },
                                  ]}
                                  data-has-media={entry.media ? "true" : "false"}
                                  data-media={entry.media ?? ""}
                                  data-caption={entry.caption ?? ""}
                                  data-name={entry.name}
                                  tabindex={entry.media ? 0 : undefined}
                                >
                                  <div class="lp-roster-row">
                                    <div class="lp-roster-main">
                                      {entry.href ? (
                                        <a class="lp-roster-name" href={entry.href}>{entry.name}</a>
                                      ) : (
                                        <span class="lp-roster-name">{entry.name}</span>
                                      )}
                                      <p class="lp-roster-detail">{entry.detail}</p>
                                    </div>
                                    <span class="lp-roster-lead" aria-hidden="true"></span>
                                    <span class="lp-roster-period">{entry.period}</span>
                                  </div>
                                </li>
                              ))}
                            </ul>
                          ))}
                        </div>
                      </div>
                    );
                  })
                }
              </div>
            </section>
          </div>
        </div>
      </main>
    </div>

    <div
      class="lp-preview"
      id="lp-preview"
      hidden
      role="dialog"
      aria-label="Aperçu du projet"
    >
      <div class="lp-bezel lp-preview-bezel">
        <div class="lp-bezel-inner lp-preview-frame">
          <video id="lp-preview-video" muted playsinline loop preload="none"></video>
          <div class="lp-preview-empty" id="lp-preview-empty" hidden>
            <span class="lp-preview-empty-kicker">Spec</span>
            <span id="lp-preview-empty-name">No preview</span>
          </div>
        </div>
      </div>
      <p class="lp-preview-cap" id="lp-preview-cap"></p>
    </div>

    <script>
      import { initLabPrecisionChrome } from "@/scripts/lab-precision-chrome";
      import { initLabPrecisionView } from "@/scripts/lab-precision-view";

      initLabPrecisionChrome();

      const mediaRoot = "/media/case-studies/everest-finance";
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const coarse = window.matchMedia("(hover: none), (pointer: coarse)");

      const rows = document.querySelectorAll<HTMLElement>(".lp-row");
      const preview = document.getElementById("lp-preview");
      const previewVideo = document.getElementById("lp-preview-video") as HTMLVideoElement | null;
      const previewEmpty = document.getElementById("lp-preview-empty");
      const previewEmptyName = document.getElementById("lp-preview-empty-name");
      const previewCap = document.getElementById("lp-preview-cap");

      let activeName = "";

      function showPreview(row: HTMLElement) {
        if (document.body.classList.contains("is-background")) return;
        if (!preview || !previewVideo || !previewEmpty || !previewCap) return;
        const name = row.getAttribute("data-name") ?? "";
        const has = row.getAttribute("data-has-media") === "true";
        const surface = row.getAttribute("data-media") || "";
        const caption = row.getAttribute("data-caption") || name;

        activeName = name;
        previewCap.textContent = caption;
        previewVideo.pause();
        previewVideo.removeAttribute("src");
        previewVideo.load();
        previewVideo.hidden = true;
        previewEmpty.hidden = true;

        if (has && surface) {
          previewVideo.hidden = false;
          previewVideo.poster = `${mediaRoot}/${surface}.jpg`;
          previewVideo.src = `${mediaRoot}/${surface}.mp4`;
          if (!reduceMotion.matches) {
            void previewVideo.play().catch(() => {});
          }
        } else {
          previewEmpty.hidden = false;
          if (previewEmptyName) previewEmptyName.textContent = name;
        }

        preview.hidden = false;
        preview.dataset.active = "true";
        requestAnimationFrame(() => {
          preview?.classList.add("is-open");
        });
        row.classList.add("is-peek");
        rows.forEach((r) => {
          if (r !== row) r.classList.remove("is-peek");
        });
      }

      function hidePreview() {
        if (!preview || !previewVideo) return;
        preview.classList.remove("is-open");
        preview.dataset.active = "false";
        activeName = "";
        previewVideo.pause();
        previewVideo.removeAttribute("src");
        previewVideo.load();
        rows.forEach((r) => r.classList.remove("is-peek"));
        window.setTimeout(
          () => {
            if (preview.dataset.active === "true") return;
            preview.hidden = true;
          },
          reduceMotion.matches ? 0 : 200,
        );
      }

      initLabPrecisionView({ onBackground: hidePreview });

      rows.forEach((row) => {
        const peekable = row.classList.contains("lp-row--peekable");

        row.addEventListener("pointerenter", (e) => {
          if (!peekable || coarse.matches) return;
          if ((e as PointerEvent).pointerType === "touch") return;
          showPreview(row);
        });

        row.addEventListener("pointerleave", () => {
          if (!peekable || coarse.matches) return;
          hidePreview();
        });

        row.addEventListener("focusin", () => {
          if (!peekable) return;
          showPreview(row);
        });

        row.addEventListener("focusout", (e) => {
          if (coarse.matches || !peekable) return;
          const next = (e as FocusEvent).relatedTarget;
          if (next && row.contains(next as Node)) return;
          hidePreview();
        });

        row.addEventListener("click", (e) => {
          if (!coarse.matches || !peekable) return;
          const open = preview?.dataset.active === "true" && !preview.hidden;
          const same = activeName === (row.getAttribute("data-name") ?? "");
          if (!open || !same) {
            e.preventDefault();
            showPreview(row);
          }
        });
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !document.body.classList.contains("is-background")) {
          hidePreview();
        }
      });

      document.addEventListener("pointerdown", (e) => {
        if (!preview || preview.hidden) return;
        const target = e.target as Node & { closest?: (s: string) => Element | null };
        if (preview.contains(target)) return;
        if (typeof target.closest === "function" && target.closest(".lp-row")) return;
        hidePreview();
      });

      const reduceReveal = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (!reduceReveal.matches) {
        const revealEls = document.querySelectorAll<HTMLElement>(".lp-reveal");
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll(".lp-reveal").forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
