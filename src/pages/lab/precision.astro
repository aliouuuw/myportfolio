---
import "@/styles/lab-precision.css";

type Domain = "Fintech" | "ERP & QA" | "Systems" | "Operations";

interface Engagement {
  name: string;
  domain: Domain;
  detail: string;
  builds: number;
  period: string;
  href?: string;
  media?: string;
  caption?: string;
}

const media = "/media/case-studies/everest-finance";

/* Index rows are engagements, not individual builds. `builds` signals depth;
   the destination page lists every surface for that client. */
const engagements: Engagement[] = [
  {
    name: "Everest Finance",
    domain: "Fintech",
    detail: "SGI · site, savings app, campaign tooling",
    builds: 3,
    period: "2025 - now",
    href: "/work/everest-finance",
    media: "website",
    caption: "Everest · public site + CMS",
  },
  {
    name: "ERGOBIT",
    domain: "ERP & QA",
    detail: "Odoo integrator · test toolkit, client modules",
    builds: 2,
    period: "2024 - 26",
    href: "/work/odoo-testing-toolkit",
  },
  {
    name: "BankingBook Analytics",
    domain: "Fintech",
    detail: "Open-banking API, domain cutover",
    builds: 2,
    period: "2023 - 24",
  },
  {
    name: "Purolator Digital Lab",
    domain: "Systems",
    detail: "CI/CD, approval tooling, warehouse SDK",
    builds: 3,
    period: "2023",
  },
  {
    name: "BocalBun",
    domain: "Systems",
    detail: "Bun toolkit, frozen deliberately",
    builds: 1,
    period: "2022",
    href: "/work/bocalbun-retrospective",
  },
  {
    name: "Mansour Holding",
    domain: "Operations",
    detail: "Automotive · dealership site, inventory",
    builds: 2,
    period: "Live",
    href: "/work/mansour-holding",
  },
  {
    name: "Ndouckmane Transit",
    domain: "Operations",
    detail: "Logistics · freight ops, customs",
    builds: 1,
    period: "Active",
    href: "/work/ndouckmane-transit",
  },
  {
    name: "Mamebimo",
    domain: "Operations",
    detail: "Marketplace · home-services booking",
    builds: 1,
    period: "Live",
  },
  {
    name: "Gerpain",
    domain: "Operations",
    detail: "Multi-bakery inventory, RBAC",
    builds: 1,
    period: "Shipped",
  },
  {
    name: "EduPlan",
    domain: "Operations",
    detail: "Education · courses, schedule, grading",
    builds: 1,
    period: "Shipped",
    href: "/work/eduplan",
  },
  {
    name: "Les Hirondelles",
    domain: "Operations",
    detail: "Education · school site, Convex CMS",
    builds: 1,
    period: "Live",
  },
  {
    name: "Asaaman",
    domain: "Systems",
    detail: "Drone / AI · semantic video search",
    builds: 1,
    period: "Live",
  },
  {
    name: "Dakar Sport",
    domain: "Operations",
    detail: "Retail · commerce and community",
    builds: 1,
    period: "Shipped",
    href: "/work/dakar-sport-shop",
  },
  {
    name: "Orange Digital Lab",
    domain: "Systems",
    detail: "React Native fitness community app",
    builds: 1,
    period: "2022",
  },
];

const domains: Domain[] = ["Fintech", "ERP & QA", "Systems", "Operations"];
const filters = [
  { label: "All", value: "all", count: engagements.length },
  ...domains.map((domain) => ({
    label: domain,
    value: domain,
    count: engagements.filter((entry) => entry.domain === domain).length,
  })),
];

const journey = [
  {
    period: "2025 - now",
    role: "Senior technical operator",
    org: "Everest Finance, Dakar",
    note: "Solo across three fintech products.",
  },
  {
    period: "2024 - 26",
    role: "Software engineer",
    org: "ERGOBIT, Dakar",
    note: "Odoo modules and migration test discipline.",
  },
  {
    period: "2023 - 24",
    role: "Contract engineer",
    org: "BankingBook Analytics",
    note: "Open-banking API layer for UEMOA ALM.",
  },
  {
    period: "2023",
    role: "COOP engineer",
    org: "Purolator Digital Lab, Ottawa",
    note: "CI/CD across three logistics codebases.",
  },
  {
    period: "2022",
    role: "COOP developer",
    org: "Orange Digital Lab",
    note: "Fitness community app, 1,000+ members.",
  },
  {
    period: "2019",
    role: "Intern",
    org: "ITech Solutions Afrique",
    note: "Azure geolocation IoT.",
  },
];

const credentials = [
  { item: "B.Sc. Software Engineering", detail: "University of Ottawa" },
  { item: "B.Sc. Computer Science", detail: "DAUST" },
  { item: "Odoo 18 Functional", detail: "Odoo" },
  { item: "Front-End Developer Professional", detail: "Meta" },
  { item: "Python Data Science", detail: "Datacamp" },
];

const everestSurfaces = [
  {
    id: "sama-naffa",
    label: "Sama Naffa",
    title: "Savings platform",
    note: "Everest Finance",
  },
  {
    id: "website",
    label: "Website",
    title: "Public site + CMS",
    note: "Everest Finance",
  },
  {
    id: "formos",
    label: "Formos",
    title: "Internal lead capture",
    note: "Everest Finance",
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aliou Wade · Product Systems Engineer</title>
    <meta
      name="description"
      content="Operational software for fintechs and operations-heavy businesses. Everest Finance, Odoo acceptance testing, systems judgment."
    />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600,700&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("lab-precision-theme") === "light") {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (e) {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-head wrap">
      <a class="wordmark" href="/lab/precision" aria-label="Aliou Wade, precision portfolio"
        >Aliou Wade</a
      >
      <nav class="mode-nav" aria-label="Portfolio view">
        <button type="button" data-mode="work" aria-pressed="true">Work</button>
        <button type="button" data-mode="about" aria-pressed="false">About</button>
        <a class="essay-link" href="/writing/why-systems-over-frameworks">Essay</a>
      </nav>
      <div class="head-tools">
        <p class="availability"><span aria-hidden="true"></span>Two client slots from Q3 2026</p>
        <button id="theme-toggle" type="button">Light</button>
      </div>
    </header>

    <!-- WORK MODE -->
    <main class="work-board wrap" data-mode-panel="work">
      <div class="work-sidebar">
        <section class="identity" aria-labelledby="work-title">
          <p class="role">Product Systems Engineer</p>
          <h1 id="work-title">Aliou Wade</h1>
          <p class="positioning">
            I build operational software for fintechs and operations-heavy businesses.
          </p>

          <div class="contact-row">
            <a href="mailto:wadealiou00@gmail.com">wadealiou00@gmail.com</a>
            <a href="https://www.linkedin.com/in/aliouuuw">LinkedIn</a>
            <a href="https://github.com/aliouuuw">GitHub</a>
            <a href="https://wa.me/221777228845">WhatsApp</a>
          </div>
          <p class="location-meta">Dakar, Senegal</p>
          <button class="profile-link" type="button" data-mode="about">
            Read my background <span aria-hidden="true">&rarr;</span>
          </button>
        </section>

        <section class="registry" aria-labelledby="registry-title">
          <div class="registry-head">
            <h2 id="registry-title">Engagements</h2>
            <span class="registry-count">{engagements.length}</span>
          </div>
          <div class="filters" role="group" aria-label="Filter by domain">
            {
              filters.map((filter) => (
                <button
                  type="button"
                  class="filter"
                  data-filter={filter.value}
                  aria-pressed={filter.value === "all" ? "true" : "false"}
                >
                  <span>{filter.label}</span>
                  <span class="filter-count">{filter.count}</span>
                </button>
              ))
            }
          </div>

          <div class="rows" id="rows">
            {
              engagements.map((entry) => {
                const attrs = {
                  "data-name": entry.name,
                  "data-domain": entry.domain,
                  "data-note": entry.detail,
                  "data-media": entry.media,
                  "data-caption": entry.caption,
                  "data-href": entry.href,
                };
                const inner = (
                  <>
                    <span class="row-main">
                      <span class="row-name">{entry.name}</span>
                      <span class="row-note">{entry.detail}</span>
                      <span class="row-meta">
                        {entry.domain} / {entry.builds} {entry.builds === 1 ? "build" : "builds"}
                      </span>
                    </span>
                    <span class="row-period">{entry.period}</span>
                  </>
                );
                return entry.href ? (
                  <a
                    class:list={["row", { "is-selected": entry.name === "Everest Finance" }]}
                    href={entry.href}
                    {...attrs}
                  >
                    {inner}
                  </a>
                ) : (
                  <button class="row" type="button" {...attrs}>
                    {inner}
                  </button>
                );
              })
            }
          </div>
        </section>
      </div>

      <section class="proof-stage" id="proof-stage" aria-live="polite">
        <div class="proof-head">
          <div>
            <p class="proof-client" id="proof-client">Everest Finance</p>
            <h2 id="proof-title">Savings platform</h2>
          </div>
          <a id="proof-link" href="/work/everest-finance"
            >Open case study <span aria-hidden="true">&nearr;</span></a
          >
        </div>

        <div class="proof-visual">
          <div class="proof-media" id="proof-media">
            <video
              id="proof-video"
              src={`${media}/sama-naffa.mp4`}
              poster={`${media}/sama-naffa.jpg`}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"></video>
          </div>
          <div class="proof-type" id="proof-type" hidden>
            <p id="proof-type-domain">Fintech</p>
            <h3 id="proof-type-name">Everest Finance</h3>
            <p id="proof-type-note">SGI, site, savings app, campaign tooling</p>
          </div>
        </div>

        <div class="surface-bar" id="surface-bar">
          <p>Product surface</p>
          <div class="surface-selectors" role="group" aria-label="Everest product surfaces">
            {
              everestSurfaces.map((surface, index) => (
                <button
                  type="button"
                  data-surface={surface.id}
                  data-title={surface.title}
                  data-note={surface.note}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  <strong>{surface.label}</strong>
                  <small>{surface.title}</small>
                </button>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <!-- ABOUT MODE -->
    <main class="about-board wrap" data-mode-panel="about" hidden>
      <section class="about-intro">
        <p class="role">Background</p>
        <h1>Engineering with operational context.</h1>
        <p class="about-bio">
          Six years building operational software across fintech, ERP, logistics, and education.
          Ottawa to Dakar, bilingual French and English. I work on the systems businesses actually
          run on, not the ones that demo well.
        </p>

        <div class="contact-row">
          <a href="mailto:wadealiou00@gmail.com">wadealiou00@gmail.com</a>
          <a href="https://www.linkedin.com/in/aliouuuw">LinkedIn</a>
        </div>
        <button class="profile-link" type="button" data-mode="work">
          <span aria-hidden="true">&larr;</span> Return to work
        </button>
      </section>

      <figure class="portrait">
        <img src="/Aliou.png" alt="Portrait of Aliou Wade" width="795" height="1024" />
        <figcaption>Aliou Wade, Dakar</figcaption>
      </figure>

      <section class="journey" aria-labelledby="journey-title">
        <div class="about-section-head">
          <h2 id="journey-title">Journey</h2>
          <span>2019 - now</span>
        </div>
        <div class="jrows">
          {
            journey.map((entry) => (
              <div class="jrow">
                <span class="jrow-period">{entry.period}</span>
                <span class="jrow-body">
                  <span class="jrow-role">{entry.role}</span>
                  <span class="jrow-org">{entry.org}</span>
                </span>
                <span class="jrow-note">{entry.note}</span>
              </div>
            ))
          }
        </div>

        <div class="about-section-head credentials-head">
          <h2>Education and certifications</h2>
          <span>{credentials.length} records</span>
        </div>
        <div class="credential-grid">
          {
            credentials.map((entry) => (
              <div class="credential">
                <span class="jrow-role">{entry.item}</span>
                <span class="jrow-note">{entry.detail}</span>
              </div>
            ))
          }
        </div>

        <div class="off-clock">
          <h2>Off the clock</h2>
          <p>Competitive chess, around 2043 bullet online. Same discipline as shipping under deadline.</p>
        </div>
      </section>
    </main>

    <script>
      const root = document.documentElement;

      /* Theme */
      const toggle = document.getElementById("theme-toggle");
      const syncToggleLabel = () => {
        if (toggle) {
          toggle.textContent = root.getAttribute("data-theme") === "light" ? "Dark" : "Light";
        }
      };
      syncToggleLabel();
      toggle?.addEventListener("click", () => {
        const next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
        root.setAttribute("data-theme", next);
        try {
          localStorage.setItem("lab-precision-theme", next);
        } catch {
          /* ignore */
        }
        syncToggleLabel();
      });

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.querySelectorAll<HTMLVideoElement>("video[autoplay]").forEach((video) => {
          video.removeAttribute("autoplay");
          video.pause();
        });
      }

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* Board mode */
      const modePanels = document.querySelectorAll<HTMLElement>("[data-mode-panel]");
      const modeButtons = document.querySelectorAll<HTMLButtonElement>("[data-mode]");
      document.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((button) => {
        button.addEventListener("click", () => {
          const mode = button.dataset.mode;
          modePanels.forEach((panel) => {
            panel.hidden = panel.dataset.modePanel !== mode;
          });
          modeButtons.forEach((control) => {
            control.setAttribute(
              "aria-pressed",
              control.dataset.mode === mode ? "true" : "false",
            );
          });
        });
      });

      /* Domain filter */
      const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
      const rows = document.querySelectorAll<HTMLElement>(".row[data-domain]");
      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const value = button.dataset.filter;
          filterButtons.forEach((b) =>
            b.setAttribute("aria-pressed", b === button ? "true" : "false"),
          );
          rows.forEach((row) => {
            row.hidden = value !== "all" && row.dataset.domain !== value;
          });
        });
      });

      /* Selected engagement and product surface */
      const proofStage = document.getElementById("proof-stage");
      const proofMedia = document.getElementById("proof-media");
      const proofType = document.getElementById("proof-type");
      const proofVideo = document.getElementById("proof-video") as HTMLVideoElement | null;
      const proofClient = document.getElementById("proof-client");
      const proofTitle = document.getElementById("proof-title");
      const proofTypeDomain = document.getElementById("proof-type-domain");
      const proofTypeName = document.getElementById("proof-type-name");
      const proofTypeNote = document.getElementById("proof-type-note");
      const proofLink = document.getElementById("proof-link") as HTMLAnchorElement | null;
      const surfaceBar = document.getElementById("surface-bar");
      const surfaceButtons = document.querySelectorAll<HTMLButtonElement>("[data-surface]");
      const mediaRoot = "/media/case-studies/everest-finance";

      const showSurface = (button: HTMLButtonElement) => {
        const surface = button.dataset.surface;
        if (!surface || !proofVideo) return;
        surfaceButtons.forEach((control) =>
          control.setAttribute("aria-pressed", control === button ? "true" : "false"),
        );
        proofVideo.poster = `${mediaRoot}/${surface}.jpg`;
        proofVideo.src = `${mediaRoot}/${surface}.mp4`;
        if (!reduced) void proofVideo.play();
        if (proofClient) proofClient.textContent = button.dataset.note ?? "Everest Finance";
        if (proofTitle) proofTitle.textContent = button.dataset.title ?? "";
      };

      surfaceButtons.forEach((button) => {
        button.addEventListener("click", () => showSurface(button));
      });

      rows.forEach((row) => {
        const activate = () => {
          rows.forEach((entry) => entry.classList.toggle("is-selected", entry === row));
          if (row.dataset.media) {
            proofStage?.classList.remove("is-type");
            if (proofMedia) proofMedia.hidden = false;
            if (proofType) proofType.hidden = true;
            if (surfaceBar) surfaceBar.hidden = false;
            const defaultSurface = document.querySelector<HTMLButtonElement>(
              '[data-surface="sama-naffa"]',
            );
            if (defaultSurface) showSurface(defaultSurface);
            if (proofLink && row.dataset.href) {
              proofLink.hidden = false;
              proofLink.href = row.dataset.href;
            }
          } else {
            proofStage?.classList.add("is-type");
            if (proofMedia) proofMedia.hidden = true;
            if (proofType) proofType.hidden = false;
            if (surfaceBar) surfaceBar.hidden = true;
            if (proofClient) proofClient.textContent = row.dataset.domain ?? "";
            if (proofTitle) proofTitle.textContent = row.dataset.name ?? "";
            if (proofTypeDomain) proofTypeDomain.textContent = row.dataset.domain ?? "";
            if (proofTypeName) proofTypeName.textContent = row.dataset.name ?? "";
            if (proofTypeNote) proofTypeNote.textContent = row.dataset.note ?? "";
            if (proofLink) {
              proofLink.hidden = !row.dataset.href;
              if (row.dataset.href) proofLink.href = row.dataset.href;
            }
          }
        };
        row.addEventListener("mouseenter", activate);
        row.addEventListener("focus", activate);
        if (row.tagName === "BUTTON") row.addEventListener("click", activate);
      });
    </script>
  </body>
</html>
