---
import "@/styles/lab-precision.css";

type Domain = "Fintech" | "ERP & QA" | "Systems" | "Operations";

interface Engagement {
  name: string;
  domain: Domain;
  detail: string;
  builds: number;
  period: string;
  href?: string;
  media?: string;
  caption?: string;
}

const media = "/media/case-studies/everest-finance";

/* Index rows are engagements, not individual builds. `builds` signals depth;
   the destination page lists every surface for that client. */
const engagements: Engagement[] = [
  {
    name: "Everest Finance",
    domain: "Fintech",
    detail: "SGI · site, savings app, campaign tooling",
    builds: 3,
    period: "2025 - now",
    href: "/work/everest-finance",
    media: "website",
    caption: "Everest · public site + CMS",
  },
  {
    name: "ERGOBIT",
    domain: "ERP & QA",
    detail: "Odoo integrator · test toolkit, client modules",
    builds: 2,
    period: "2024 - 26",
    href: "/work/odoo-testing-toolkit",
  },
  {
    name: "BankingBook Analytics",
    domain: "Fintech",
    detail: "Open-banking API, domain cutover",
    builds: 2,
    period: "2023 - 24",
  },
  {
    name: "Purolator Digital Lab",
    domain: "Systems",
    detail: "CI/CD, approval tooling, warehouse SDK",
    builds: 3,
    period: "2023",
  },
  {
    name: "BocalBun",
    domain: "Systems",
    detail: "Bun toolkit, frozen deliberately",
    builds: 1,
    period: "2022",
    href: "/work/bocalbun-retrospective",
  },
  {
    name: "Mansour Holding",
    domain: "Operations",
    detail: "Automotive · dealership site, inventory",
    builds: 2,
    period: "Live",
    href: "/work/mansour-holding",
  },
  {
    name: "Ndouckmane Transit",
    domain: "Operations",
    detail: "Logistics · freight ops, customs",
    builds: 1,
    period: "Active",
    href: "/work/ndouckmane-transit",
  },
  {
    name: "Mamebimo",
    domain: "Operations",
    detail: "Marketplace · home-services booking",
    builds: 1,
    period: "Live",
  },
  {
    name: "Gerpain",
    domain: "Operations",
    detail: "Multi-bakery inventory, RBAC",
    builds: 1,
    period: "Shipped",
  },
  {
    name: "EduPlan",
    domain: "Operations",
    detail: "Education · courses, schedule, grading",
    builds: 1,
    period: "Shipped",
    href: "/work/eduplan",
  },
  {
    name: "Les Hirondelles",
    domain: "Operations",
    detail: "Education · school site, Convex CMS",
    builds: 1,
    period: "Live",
  },
  {
    name: "Asaaman",
    domain: "Systems",
    detail: "Drone / AI · semantic video search",
    builds: 1,
    period: "Live",
  },
  {
    name: "Dakar Sport",
    domain: "Operations",
    detail: "Retail · commerce and community",
    builds: 1,
    period: "Shipped",
    href: "/work/dakar-sport-shop",
  },
  {
    name: "Orange Digital Lab",
    domain: "Systems",
    detail: "React Native fitness community app",
    builds: 1,
    period: "2022",
  },
];

const domains: Domain[] = ["Fintech", "ERP & QA", "Systems", "Operations"];
const filters = [
  { label: "All", value: "all", count: engagements.length },
  ...domains.map((domain) => ({
    label: domain,
    value: domain,
    count: engagements.filter((entry) => entry.domain === domain).length,
  })),
];

const journey = [
  {
    period: "2025 - now",
    role: "Senior technical operator",
    org: "Everest Finance, Dakar",
    note: "Solo across three fintech products.",
  },
  {
    period: "2024 - 26",
    role: "Software engineer",
    org: "ERGOBIT, Dakar",
    note: "Odoo modules and migration test discipline.",
  },
  {
    period: "2023 - 24",
    role: "Contract engineer",
    org: "BankingBook Analytics",
    note: "Open-banking API layer for UEMOA ALM.",
  },
  {
    period: "2023",
    role: "COOP engineer",
    org: "Purolator Digital Lab, Ottawa",
    note: "CI/CD across three logistics codebases.",
  },
  {
    period: "2022",
    role: "COOP developer",
    org: "Orange Digital Lab",
    note: "Fitness community app, 1,000+ members.",
  },
  {
    period: "2019",
    role: "Intern",
    org: "ITech Solutions Afrique",
    note: "Azure geolocation IoT.",
  },
];

const credentials = [
  { item: "B.Sc. Software Engineering", detail: "University of Ottawa" },
  { item: "B.Sc. Computer Science", detail: "DAUST" },
  { item: "Odoo 18 Functional", detail: "Odoo" },
  { item: "Front-End Developer Professional", detail: "Meta" },
  { item: "Python Data Science", detail: "Datacamp" },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aliou Wade · Product Systems Engineer</title>
    <meta
      name="description"
      content="Operational software for fintechs and operations-heavy businesses. Everest Finance, Odoo acceptance testing, systems judgment."
    />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600,700&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("lab-precision-theme") === "light") {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (e) {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-head wrap">
      <span class="mono">Aliou Wade</span>
      <div class="head-right">
        <p class="mono status">Two client slots from Q3 2026</p>
        <button id="theme-toggle" class="mono" type="button">Light</button>
      </div>
    </header>

    <!-- WORK MODE -->
    <main class="board wrap" data-mode-panel="work">
      <div class="identity">
        <h1>Aliou Wade</h1>
        <p class="positioning">
          I build operational software for fintechs and operations-heavy businesses.
        </p>

        <div class="contact-row">
          <a href="mailto:wadealiou00@gmail.com">wadealiou00@gmail.com</a>
          <a href="https://www.linkedin.com/in/aliouuuw">LinkedIn</a>
          <a href="https://github.com/aliouuuw">GitHub</a>
          <a href="https://wa.me/221777228845">WhatsApp</a>
        </div>

        <button class="mono profile-link" type="button" data-mode="about">
          About me <span aria-hidden="true">&rarr;</span>
        </button>

        <div class="preview" id="preview">
          <div class="frame">
            <div class="preview-media">
              <video
                src={`${media}/website.mp4`}
                poster={`${media}/website.jpg`}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"></video>
            </div>
            <div class="preview-type">
              <span class="type-name" id="preview-type-name"></span>
              <span class="type-note" id="preview-type-note"></span>
            </div>
          </div>
          <p class="mono preview-caption" id="preview-caption">Everest · public site + CMS</p>
        </div>
      </div>

      <div class="index">
        <div class="filters" role="group" aria-label="Filter by domain">
          {
            filters.map((filter) => (
              <button
                type="button"
                class="filter"
                data-filter={filter.value}
                aria-pressed={filter.value === "all" ? "true" : "false"}
              >
                <span class="mono">{filter.label}</span>
                <span class="mono filter-count">{filter.count}</span>
              </button>
            ))
          }
        </div>

        <div class="index-head mono">
          <span>Engagement</span>
          <span>Domain</span>
          <span>Scope</span>
          <span style="text-align: right">Builds</span>
          <span style="text-align: right">Period</span>
        </div>

        <div class="rows" id="rows">
          {
            engagements.map((entry) => {
              const attrs = {
                "data-name": entry.name,
                "data-domain": entry.domain,
                "data-note": entry.detail,
                "data-media": entry.media,
                "data-caption": entry.caption,
              };
              const inner = (
                <>
                  <span class="row-name">{entry.name}</span>
                  <span class="row-domain">{entry.domain}</span>
                  <span class="row-note">{entry.detail}</span>
                  <span class="mono row-builds">
                    {entry.builds} {entry.builds === 1 ? "build" : "builds"}
                  </span>
                  <span class="mono row-period">{entry.period}</span>
                </>
              );
              return entry.href ? (
                <a class="row" href={entry.href} {...attrs}>
                  {inner}
                </a>
              ) : (
                <div class="row" {...attrs}>
                  {inner}
                </div>
              );
            })
          }
        </div>
      </div>
    </main>

    <!-- ABOUT MODE -->
    <main class="board wrap" data-mode-panel="about" hidden>
      <div class="identity about-identity">
        <button class="mono profile-link back" type="button" data-mode="work">
          <span aria-hidden="true">&larr;</span> Work
        </button>

        <div class="portrait">
          <div class="portrait-frame">
            <span class="mono portrait-note">Portrait</span>
          </div>
        </div>

        <p class="about-bio">
          Six years building operational software across fintech, ERP, logistics, and education.
          Ottawa to Dakar, bilingual French and English. I work on the systems businesses actually
          run on, not the ones that demo well.
        </p>

        <div class="contact-row">
          <a href="mailto:wadealiou00@gmail.com">wadealiou00@gmail.com</a>
          <a href="https://www.linkedin.com/in/aliouuuw">LinkedIn</a>
        </div>
      </div>

      <div class="index">
        <p class="mono about-group first">Journey</p>
        <div class="jrows">
          {
            journey.map((entry) => (
              <div class="jrow">
                <span class="mono jrow-period">{entry.period}</span>
                <span class="jrow-body">
                  <span class="jrow-role">{entry.role}</span>
                  <span class="jrow-org">{entry.org}</span>
                </span>
                <span class="jrow-note">{entry.note}</span>
              </div>
            ))
          }
        </div>

        <p class="mono about-group">Education and certifications</p>
        <div class="jrows">
          {
            credentials.map((entry) => (
              <div class="jrow jrow-simple">
                <span class="jrow-role">{entry.item}</span>
                <span class="jrow-note">{entry.detail}</span>
              </div>
            ))
          }
        </div>

        <p class="mono about-group">Off the clock</p>
        <p class="about-note">
          Competitive chess, around 2043 bullet online. Same discipline as shipping under deadline.
        </p>
      </div>
    </main>

    <footer class="site-foot wrap">
      <span class="mono">Dakar, Senegal</span>
      <a class="mono" href="/writing/why-systems-over-frameworks"
        >Essay: why systems over frameworks</a
      >
    </footer>

    <script>
      const root = document.documentElement;

      /* Theme */
      const toggle = document.getElementById("theme-toggle");
      const syncToggleLabel = () => {
        if (toggle) {
          toggle.textContent = root.getAttribute("data-theme") === "light" ? "Dark" : "Light";
        }
      };
      syncToggleLabel();
      toggle?.addEventListener("click", () => {
        const next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
        root.setAttribute("data-theme", next);
        try {
          localStorage.setItem("lab-precision-theme", next);
        } catch {
          /* ignore */
        }
        syncToggleLabel();
      });

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.querySelectorAll<HTMLVideoElement>("video[autoplay]").forEach((video) => {
          video.removeAttribute("autoplay");
          video.pause();
        });
      }

      /* Board mode: work <-> about */
      const modePanels = document.querySelectorAll<HTMLElement>("[data-mode-panel]");
      document.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((button) => {
        button.addEventListener("click", () => {
          const mode = button.dataset.mode;
          modePanels.forEach((panel) => {
            panel.hidden = panel.dataset.modePanel !== mode;
          });
        });
      });

      /* Domain filter */
      const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
      const rows = document.querySelectorAll<HTMLElement>(".row[data-domain]");
      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const value = button.dataset.filter;
          filterButtons.forEach((b) =>
            b.setAttribute("aria-pressed", b === button ? "true" : "false"),
          );
          rows.forEach((row) => {
            row.hidden = value !== "all" && row.dataset.domain !== value;
          });
        });
      });

      /* Preview swap */
      const preview = document.getElementById("preview");
      const previewTypeName = document.getElementById("preview-type-name");
      const previewTypeNote = document.getElementById("preview-type-note");
      const previewCaption = document.getElementById("preview-caption");

      rows.forEach((row) => {
        const activate = () => {
          if (!preview || !previewCaption) return;
          if (row.dataset.media) {
            preview.classList.remove("is-type");
            previewCaption.textContent = row.dataset.caption ?? "";
          } else {
            preview.classList.add("is-type");
            if (previewTypeName) previewTypeName.textContent = row.dataset.name ?? "";
            if (previewTypeNote) previewTypeNote.textContent = row.dataset.note ?? "";
            previewCaption.textContent = `${row.dataset.name ?? ""} · ${row.dataset.domain ?? ""}`;
          }
        };
        row.addEventListener("mouseenter", activate);
        row.addEventListener("focus", activate);
      });
    </script>
  </body>
</html>
